<?xml version="1.0"?>
<ruleset name="SynapseFabric SEO Abilities">
	<file>.</file>
	<exclude-pattern>/vendor/</exclude-pattern>
	<exclude-pattern>/node_modules/</exclude-pattern>
	<exclude-pattern>/tests/</exclude-pattern>
	<arg name="extensions" value="php"/>
	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="7.4-"/>
	<config name="minimum_supported_wp_version" value="6.9"/>
	<rule ref="WordPress.WP.I18n">
		<properties><property name="text_domain" type="array"><element value="synapsefabric-seo-abilities"/></property></properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties><property name="prefixes" type="array"><element value="sfsa"/></property></properties>
	</rule>
</ruleset>
